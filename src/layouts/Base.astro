---
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Charles & Joe's long-weekend itinerary in Glasgow — gigs, galleries, dive bars, whisky." } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#121110" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;500;700;900&family=Space+Mono:wght@400;700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to itinerary</a>

    <!-- Halftone + duotone SVG filters reused by all image components. -->
    <svg width="0" height="0" style="position:absolute;pointer-events:none" aria-hidden="true">
      <defs>
        <!-- Duotone: maps luminance to bone (cream) → riso-red gradient. -->
        <filter id="halftone-riso" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="
            0.33 0.33 0.33 0 0
            0.33 0.33 0.33 0 0
            0.33 0.33 0.33 0 0
            0    0    0    1 0
          "/>
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.07 1.00"/>
            <feFuncG type="table" tableValues="0.07 0.91"/>
            <feFuncB type="table" tableValues="0.06 0.85"/>
          </feComponentTransfer>
          <feComponentTransfer>
            <feFuncR type="discrete" tableValues="0.07 0.07 0.07 1.00 1.00 1.00"/>
            <feFuncG type="discrete" tableValues="0.07 0.07 0.07 0.23 0.91 0.91"/>
            <feFuncB type="discrete" tableValues="0.06 0.06 0.06 0.13 0.85 0.85"/>
          </feComponentTransfer>
        </filter>

        <!-- Duotone red→cream with extra contrast for the gig/marquee shots. -->
        <filter id="halftone-acid" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="
            0.33 0.33 0.33 0 0
            0.33 0.33 0.33 0 0
            0.33 0.33 0.33 0 0
            0    0    0    1 0
          "/>
          <feComponentTransfer>
            <feFuncR type="table" tableValues="0.07 1.00"/>
            <feFuncG type="table" tableValues="0.07 0.83"/>
            <feFuncB type="table" tableValues="0.06 0.00"/>
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>

    <slot />
  </body>
</html>
