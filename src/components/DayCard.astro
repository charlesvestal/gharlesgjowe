---
import type { Day } from '../data/trip';
import StopRow from './StopRow.astro';
import WeatherStrip from './WeatherStrip.astro';

interface Props {
  day: Day;
  dayNumber: number;
  showWeatherCaveat: boolean;
  caveat: string;
}

const { day, dayNumber, showWeatherCaveat, caveat } = Astro.props;
const slug = day.code.toLowerCase().replace(/\s+/g, '-');
const stamp = String(dayNumber).padStart(2, '0');
---
<section class="day" id={slug} data-date={day.iso} aria-labelledby={`${slug}-h`}>
  <div class="day__bar" aria-hidden="true">
    <span class="day__bar-code">{day.code}</span>
    <span class="day__bar-date">{day.date}</span>
    <span class="day__bar-theme">{day.theme}</span>
    <span class="day__bar-today">Today</span>
  </div>

  <header class="day__head">
    <div class="day__stamp" aria-hidden="true">{stamp}</div>
    <div class="day__heading">
      <p class="day__code meta">
        {day.code} · {day.date}
        <span class="day__tag day__tag--today" hidden>· Today</span>
        <span class="day__tag day__tag--past" hidden>· Done</span>
      </p>
      <h3 class="day__theme" id={`${slug}-h`}>{day.theme}</h3>
    </div>
  </header>

  <ul class="day__glance" aria-label={`At a glance — ${day.theme}`}>
    {day.stops.map((stop) => (
      <li class="day__glance-item">
        <span class="day__glance-time">{stop.time}</span>
        <span class="day__glance-title">{stop.title}</span>
      </li>
    ))}
  </ul>

  <WeatherStrip weather={day.weather} caveat={caveat} showCaveat={showWeatherCaveat} />

  <ol class="day__stops" aria-label={`Stops for ${day.theme}`}>
    {day.stops.map((stop, i) => (
      <li><StopRow stop={stop} index={i} /></li>
    ))}
  </ol>
</section>

<style>
  .day {
    padding: 2.5rem 0;
    border-top: var(--rule-thick) solid var(--bone);
    position: relative;
    scroll-margin-top: 5.5rem;
  }
  .day:first-of-type { border-top: 0; }

  /* --- "what day is it" states (toggled client-side) --- */

  /* Today: pull it forward with an acid rail and a glow. */
  .day.is-today {
    border-top-color: var(--acid);
  }
  .day.is-today::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--gutter, 1rem));
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--acid);
  }

  /* Past days: dim and desaturate, but keep them readable if opened. */
  .day.is-past { opacity: 0.5; transition: opacity var(--dur) var(--ease); }
  .day.is-past:hover,
  .day.is-past:focus-within { opacity: 1; }

  .day__bar-today {
    display: none;
    margin-left: auto;
    flex: 0 0 auto;
    padding: 0 0.4rem;
    background: var(--acid);
    color: var(--ink);
    font-weight: 700;
    border-radius: 2px;
  }
  .day.is-today .day__bar-today { display: inline-block; }
  .day.is-today .day__bar { border-bottom-color: var(--acid); }

  .day__tag {
    font-family: var(--ff-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .day__tag--today { color: var(--acid); font-weight: 700; }
  .day__tag--past { color: var(--bone-dim); }
  @media (prefers-reduced-motion: reduce) {
    .day.is-past { transition: none; }
  }

  /* slim sticky day header — locks under the nav as you scroll the day */
  .day__bar {
    position: sticky;
    top: var(--nav-h, 56px);
    z-index: 5;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    padding: 0.5rem 0.7rem;
    background: var(--ink);
    border-bottom: var(--rule) solid var(--acid);
    font-family: var(--ff-mono);
    font-size: var(--fs-meta);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    overflow: hidden;
  }
  .day__bar-code { color: var(--acid); font-weight: 700; flex: 0 0 auto; }
  .day__bar-date { color: var(--bone-dim); flex: 0 0 auto; }
  .day__bar-theme {
    color: var(--bone);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .day__head {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .day__stamp {
    font-family: var(--ff-display);
    font-size: clamp(3.5rem, 10vw, 7rem);
    color: var(--riso-red);
    line-height: 0.85;
    flex: 0 0 auto;
    transform: rotate(-3deg);
    text-shadow: 0.02em 0.02em 0 var(--acid);
    -webkit-text-stroke: 1px var(--riso-red);
  }

  .day__heading {
    flex: 1 1 auto;
    padding-top: 0.25rem;
  }

  .day__code {
    margin: 0 0 0.4rem 0;
    color: var(--acid);
  }

  .day__theme {
    font-family: var(--ff-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 0.95;
    color: var(--bone);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  /* at-a-glance run sheet */
  .day__glance {
    list-style: none;
    margin: 0 0 1.75rem 0;
    padding: 1rem 1.1rem;
    background: var(--ink-2);
    border-left: 3px solid var(--acid);
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem 1.5rem;
  }
  @media (min-width: 600px) {
    .day__glance { grid-template-columns: 1fr 1fr; }
  }
  .day__glance-item {
    display: flex;
    gap: 0.65rem;
    align-items: baseline;
    line-height: 1.3;
  }
  .day__glance-time {
    flex: 0 0 auto;
    min-width: 3.6rem;
    font-family: var(--ff-mono);
    font-size: var(--fs-small);
    color: var(--acid);
    text-align: right;
  }
  .day__glance-title {
    font-size: 0.88rem;
    color: var(--bone);
  }

  .day__stops {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .day__stops > li { display: block; }
</style>
