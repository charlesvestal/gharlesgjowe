---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DayCard from '../components/DayCard.astro';
import Checklist from '../components/Checklist.astro';
import DrinksPlan from '../components/DrinksPlan.astro';
import FoodAlternates from '../components/FoodAlternates.astro';
import NearTheFlat from '../components/NearTheFlat.astro';
import JoeCoda from '../components/JoeCoda.astro';
import Footer from '../components/Footer.astro';
import { trip } from '../data/trip';

const title = `${trip.title} · ${trip.travellers.join(' × ')} · ${trip.dates}`;
---
<Base title={title}>
  <Hero
    title={trip.title}
    travellers={trip.travellers}
    dates={trip.dates}
    tagline={trip.tagline}
    flightOut={trip.flights.out}
    flightBack={trip.flights.back}
  />

  <nav class="daynav" aria-label="Jump to day">
    <ul class="daynav__list wrap">
      {trip.days.map((day) => {
        const slug = day.code.toLowerCase().replace(/\s+/g, '-');
        return (
          <li>
            <a href={`#${slug}`} data-date={day.iso}>
              <span class="daynav__code">{day.code}</span>
              <span class="daynav__date">{day.date}</span>
            </a>
          </li>
        );
      })}
      <li><a href="#checklist" class="daynav__pill">Checklist</a></li>
      <li><a href="#tab" class="daynav__pill daynav__pill--tab">The Tab</a></li>
      <li><a href="#near" class="daynav__pill daynav__pill--near">By the flat</a></li>
      <li><a href="#food" class="daynav__pill daynav__pill--food">Food</a></li>
      <li><a href="#joe" class="daynav__pill daynav__pill--joe">Joe's coda</a></li>
    </ul>
  </nav>

  <main id="main" class="wrap main">
    <aside class="today-banner" hidden aria-live="polite">
      <span class="today-banner__label" data-today-label></span>
      <a class="today-banner__jump" href="#" data-today-jump hidden>Jump to today ↓</a>
    </aside>

    <Checklist items={[...trip.checklist]} />

    <DrinksPlan
      intro={trip.drinksPlan.intro}
      perPerson={trip.drinksPlan.perPerson}
      unitsPerPerson={trip.drinksPlan.unitsPerPerson}
      days={[...trip.drinksPlan.days]}
      rules={[...trip.drinksPlan.rules]}
      caveat={trip.drinksPlan.caveat}
    />

    <p class="menu-note">
      <strong>It's a menu, not a checklist.</strong> Everything below is optional — drop
      anything tagged <span class="menu-note__tag">Optional</span>, swap freely, and don't
      sweat hitting every stop. The only fixed points are the gig (Sat) and the booked dinners.
      Build in a lazy hour where you fancy.
    </p>

    {trip.days.map((day, i) => (
      <DayCard
        day={day}
        dayNumber={i + 1}
        showWeatherCaveat={i === 0}
        caveat={trip.weatherCaveat}
      />
    ))}

    <NearTheFlat intro={trip.nearTheFlat.intro} groups={[...trip.nearTheFlat.groups]} />

    <FoodAlternates groups={trip.foodAlternates} />

    <JoeCoda coda={trip.joesCoda} />
  </main>

  <Footer items={trip.footer.items} />
</Base>

<style>
  .main {
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
    max-width: 700px;
  }

  .today-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    flex-wrap: wrap;
    margin: 0 0 2rem 0;
    padding: 0.8rem 1.1rem;
    background: var(--acid);
    color: var(--ink);
    border: var(--rule) solid var(--ink);
  }
  .today-banner__label {
    font-family: var(--ff-mono);
    font-size: 0.95rem;
    line-height: 1.4;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .today-banner__jump {
    margin-left: auto;
    flex: 0 0 auto;
    padding: 0.25rem 0.6rem;
    background: var(--ink);
    color: var(--acid);
    text-decoration: none;
    font-family: var(--ff-mono);
    font-size: var(--fs-meta);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1px solid var(--ink);
  }
  .today-banner__jump:hover,
  .today-banner__jump:focus-visible {
    background: var(--riso-red);
    color: var(--bone);
    outline: none;
  }

  .daynav__list a.is-today {
    background: var(--acid);
    color: var(--ink);
    border-color: var(--acid);
  }
  .daynav__list a.is-today .daynav__code { color: var(--ink); }
  .daynav__list a.is-past { opacity: 0.55; }

  .menu-note {
    margin: 0 0 2rem 0;
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--acid);
    background: var(--ink-2);
    font-size: 0.95rem;
    color: var(--bone);
    line-height: 1.45;
  }
  .menu-note strong { color: var(--acid); }
  .menu-note__tag {
    font-family: var(--ff-mono);
    font-size: var(--fs-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--acid);
    border: 1px dashed var(--acid);
    padding: 0 0.3rem;
    white-space: nowrap;
  }

  .daynav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--ink);
    border-bottom: var(--rule) solid var(--bone);
  }
  .daynav__list {
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--gutter);
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .daynav__list li { flex: 0 0 auto; }
  .daynav__list a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.4rem 0.7rem;
    text-decoration: none;
    color: var(--bone);
    border: 1px solid var(--bone-faint);
    font-family: var(--ff-mono);
    font-size: var(--fs-meta);
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .daynav__list a:hover,
  .daynav__list a:focus-visible {
    background: var(--acid);
    color: var(--ink);
    border-color: var(--acid);
    outline: none;
  }
  .daynav__code { font-weight: 700; color: var(--acid); }
  .daynav__list a:hover .daynav__code,
  .daynav__list a:focus-visible .daynav__code { color: var(--ink); }
  .daynav__date { color: inherit; }
  .daynav__pill { background: var(--riso-red); color: var(--ink); border-color: var(--riso-red); }
  .daynav__pill:hover, .daynav__pill:focus-visible { background: var(--acid); color: var(--ink); border-color: var(--acid); }
  .daynav__pill--food { background: var(--acid); color: var(--ink); border-color: var(--acid); }
  .daynav__pill--food:hover, .daynav__pill--food:focus-visible { background: var(--riso-red); color: var(--ink); border-color: var(--riso-red); }
  .daynav__list a.daynav__pill--tab { background: var(--acid); color: var(--ink); border-color: var(--acid); }
  .daynav__list a.daynav__pill--tab:hover, .daynav__list a.daynav__pill--tab:focus-visible { background: var(--riso-red); color: var(--ink); border-color: var(--riso-red); }
  .daynav__list a.daynav__pill--near { background: var(--bone); color: var(--ink); border-color: var(--bone); }
  .daynav__list a.daynav__pill--near:hover, .daynav__list a.daynav__pill--near:focus-visible { background: var(--acid); color: var(--ink); border-color: var(--acid); }
  .daynav__list a.daynav__pill--joe { background: var(--riso-red); color: var(--bone); border-color: var(--riso-red); }
  .daynav__list a.daynav__pill--joe .daynav__code { color: var(--bone); }
  .daynav__list a.daynav__pill--joe:hover, .daynav__list a.daynav__pill--joe:focus-visible { background: var(--acid); color: var(--ink); border-color: var(--acid); }
</style>

<script>
  // Measure the sticky nav so each day's sticky header locks right beneath it.
  const root = document.documentElement;
  const nav = document.querySelector('.daynav') as HTMLElement | null;
  const setNavH = () => {
    if (nav) root.style.setProperty('--nav-h', nav.offsetHeight + 'px');
  };
  setNavH();
  window.addEventListener('resize', setNavH);
  window.addEventListener('load', setNavH);

  // --- "what day is it" — flag today, dim the past, live in the browser ---
  (() => {
    const pad = (n: number) => String(n).padStart(2, '0');
    const now = new Date();
    const todayISO = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;

    const dayCards = Array.from(document.querySelectorAll<HTMLElement>('.day[data-date]'));
    const navLinks = Array.from(document.querySelectorAll<HTMLElement>('.daynav__list a[data-date]'));
    if (!dayCards.length) return;

    const dates = dayCards.map((el) => el.dataset.date || '');
    const first = dates[0];
    const last = dates[dates.length - 1];

    const weekday = new Intl.DateTimeFormat('en-GB', { weekday: 'long' }).format(now);
    const dayMonth = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long' }).format(now);

    let todayCard: HTMLElement | null = null;

    const classify = (el: HTMLElement) => {
      const d = el.dataset.date || '';
      if (d === todayISO) return 'is-today';
      if (d < todayISO) return 'is-past';
      return 'is-upcoming';
    };

    for (const el of dayCards) {
      const state = classify(el);
      el.classList.add(state);
      if (state === 'is-today') {
        todayCard = el;
        el.querySelectorAll<HTMLElement>('.day__tag--today').forEach((t) => (t.hidden = false));
      } else if (state === 'is-past') {
        el.querySelectorAll<HTMLElement>('.day__tag--past').forEach((t) => (t.hidden = false));
      }
    }
    for (const a of navLinks) {
      a.classList.add(classify(a));
    }

    // Banner copy
    const banner = document.querySelector<HTMLElement>('.today-banner');
    const label = document.querySelector<HTMLElement>('[data-today-label]');
    const jump = document.querySelector<HTMLAnchorElement>('[data-today-jump]');
    if (!banner || !label) return;

    if (todayCard) {
      const code = todayCard.querySelector('.day__bar-code')?.textContent?.trim() || '';
      const theme = todayCard.querySelector('.day__theme')?.textContent?.trim() || '';
      label.textContent = `📍 Today is ${weekday} ${dayMonth} — ${code}: ${theme}`;
      if (jump && todayCard.id) {
        jump.href = `#${todayCard.id}`;
        jump.hidden = false;
      }
    } else if (todayISO < first) {
      label.textContent = `Not yet — the trip starts ${new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(first))}. Bags packed?`;
    } else if (todayISO > last) {
      label.textContent = `That's a wrap — the Glasgow weekend is done. Safe travels home. 🏴`;
    } else {
      // A gap day between listed days (shouldn't happen here) — say nothing loud.
      label.textContent = `📅 Today is ${weekday} ${dayMonth}.`;
    }
    banner.hidden = false;
  })();
</script>
